# --- Datastores ---
TIGER_DATABASE_URL=postgres://user:pass@host:port/db?sslmode=require
REDIS_URL=redis://localhost:6379

# --- Embeddings (Voyage AI, code-specialized, 256-dim) ---
VOYAGE_API_KEY=

# --- Reasoning (Groq, OpenAI-compatible) ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Unused provider fallbacks (interface is provider-agnostic; swap in llm_client) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- GitHub App (for real diff fetch + review posting) ---
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_PATH=/absolute/path/to/app-private-key.pem

# --- Policy knobs (ADR-000) ---
DAILY_BUDGET_USD=5.00
CONFIDENCE_THRESHOLD=0.75
